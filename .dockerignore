# The image holds versioned code only. Anything that is server-specific config,
# a secret, or build noise stays out.
.git
.gitignore
__pycache__/
*.pyc
.DS_Store

# Secrets and server config: mounted at run time from the server's config/ dir.
config.json
secret_key.txt

# User data, bind-mounted from the server's data/uploads and data/db — never baked
# in. data/ is also where a local dev or test database lives.
inventory/api/static/uploads/
data/

# Local-only stuff.
venv/
.venv/
tests/
*.md
deploy/
docker/
misc/
!misc/set_admin.py
Makefile
pytest.ini
.coverage
htmlcov/
.pytest_cache/
*.egg-info/
.idea/
.claude/
build/
dist/
