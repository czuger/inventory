# nginx snippet for this app — a `location` block, meant to be included by the
# server{} that already owns server_name and TLS (sites/apps.conf includes
# /etc/nginx/sites/apps/*.conf). It is uploaded to
# NGINX_CONF_DIR on the server by `make setup` / `make nginx`, never by a deploy.
#
# Do not edit the deployed copy on the server: it is rendered from this template
# and overwritten. The __PLACEHOLDERS__ come from deploy/config.sh, so the prefix
# and the socket cannot drift from what the deploy actually runs.

# https://<host>__PREFIX__ (no trailing slash) would otherwise miss the block below.
location = __PREFIX__ { return 301 __PREFIX__/; }

location __PREFIX__/ {
    # No port and no docker network: the app is a systemd user service on the host,
    # listening on a Unix socket. The host directory holding it is bind-mounted into
    # this container (see nginx_proxy's docker-compose.yml), and this is the path
    # inside it (deploy/config.sh: NGINX_SOCKET_DIR, SOCKET_NAME).
    #
    # Unlike a container name, a socket path needs no resolver: `nginx -t` passes and
    # nginx starts even before the first deploy or while the app is down — those
    # requests just get a 502. A restart of the app keeps the same path, so nginx has
    # nothing to re-resolve after a deploy.
    #
    # The ":/" after the socket path strips the prefix: /inventory/x reaches the app
    # as /x. It still builds its links under __PREFIX__ because it is started with
    # URL_PREFIX set from the same deploy/config.sh that rendered this file.
    proxy_pass http://unix:__SOCKET__:/;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Item photos are uploaded straight from a phone camera, several at a time.
    # nginx's default is 1m, which rejects a single modern photo with a bare 413
    # long before the app sees the request.
    client_max_body_size 32m;

    # /<slug>/print/stickers renders a QR code per item and can walk the whole
    # inventory in one request; the default 60s proxy read timeout is the limit
    # that would bite first.
    proxy_read_timeout 120s;
}
